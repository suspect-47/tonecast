# Copy these values into your shell environment. Do not put a real key in this file.
ELEVENLABS_API_KEY=replace-with-a-new-restricted-key
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
INBOX_PARADE_VOICE_PORT=8787
INBOX_PARADE_DAILY_CHARACTERS=10000

# Optional production hardening: comma-separated exact origins.
# INBOX_PARADE_ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://127.0.0.1:4173

# Enterprise-only ElevenLabs zero-retention mode.
# ELEVENLABS_ZERO_RETENTION=true

# Optional exact voice overrides after discovering voices in your account.
# ELEVENLABS_VOICE_DEADLINE_FOX=voice-id
# ELEVENLABS_VOICE_WARM_COWORKER=voice-id
